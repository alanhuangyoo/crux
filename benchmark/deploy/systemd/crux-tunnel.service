# Publishes the router through the jump box.
#
#   client -> 8.210.147.108:18077 -> (socat) -> jump 127.0.0.1:18078
#          -> (this reverse tunnel) -> h20-45:30080 router
#
# The socat hop exists because sshd binds -R forwards to loopback unless
# GatewayPorts is on, and turning that on would expose every future forward on
# that box, not just this one. socat re-publishes exactly this port and nothing
# else.
#
# Everything public terminates at the router, which rejects any request without
# the API key -- verified: 401 with no key, 401 with a wrong one.
#
# ServerAlive* is what makes this survive a NAT timeout: without it the tunnel
# stays "up" on this side long after the jump box has forgotten it, and the
# endpoint blackholes instead of reconnecting.
[Unit]
Description=Crux public tunnel (jump:18078 -> local router)
After=network-online.target crux-router.service

[Service]
Type=exec
ExecStart=/usr/bin/ssh -NT \
  -i /root/.ssh/id_ed25519_jump \
  -o StrictHostKeyChecking=no \
  -o BatchMode=yes \
  -o ExitOnForwardFailure=yes \
  -o ServerAliveInterval=20 \
  -o ServerAliveCountMax=3 \
  -R 18078:127.0.0.1:30080 \
  root@8.210.147.108
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
