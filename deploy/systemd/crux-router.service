[Unit]
Description=Crux SGLang cache-aware router
After=network-online.target

[Service]
Type=exec
ExecStart=/mnt/cpfs/users/xiaohuang/router.sh
Restart=always
RestartSec=5
# The router polls its workers and waits rather than failing, so it can start
# before them; this only has to outlast a cold engine boot.
TimeoutStartSec=2400
StandardOutput=append:/mnt/cpfs/users/xiaohuang/logs/router.log
StandardError=inherit
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
